# ---- AI keys (free tiers). Optional: without them the pipeline uses hand-written fallback scripts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Telegram review bot (see docs/SETUP_TELEGRAM.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- YouTube Data API v3 OAuth (see docs/SETUP_YOUTUBE.md; run `npm run auth:youtube` to get the refresh token)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- GitHub (only needed locally if you want to upload drafts to Releases; Actions provides it automatically)
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# ---- Optional overrides
# CHANNEL_LANGUAGE=en
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome
# HF_CACHE_DIR=.cache/hf
# WHISPER_DIR=.cache/whisper
# ALLOW_FALLBACK_VOICE=false      # dry runs on offline machines: use the bundled eSpeak voice if Kokoro cannot load
