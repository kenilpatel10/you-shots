# ---- AI keys (free tiers). Optional: without them the pipeline uses hand-written fallback scripts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Free tier: ~20 requests/day per model; these are tried in order when a model's daily quota is spent
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Telegram review bot (see docs/SETUP_TELEGRAM.md)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- YouTube Data API v3 OAuth (see docs/SETUP_YOUTUBE.md; run `npm run auth:youtube` to get the refresh token)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Extra channels: one suffixed token per language listed in CHANNEL_LANGUAGES (npm run auth:youtube -- --language hi)
YOUTUBE_REFRESH_TOKEN_HI=

# ---- GitHub (only needed locally if you want to upload drafts to Releases; Actions provides it automatically)
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

# ---- Optional overrides
# CHANNEL_LANGUAGE=en                 # language this process renders for (Actions sets it per matrix job)
# CHANNEL_LANGUAGES=["en","hi"]       # all channel languages of the default persona (Actions variable)
# CHANNELS=["bolt-pip/en","ncert-science/hi"]   # all channels (persona/lang); overrides CHANNEL_LANGUAGES
# CHANNEL=ncert-science/hi            # the one channel this process renders (Actions sets it per matrix job)
# YOUTUBE_REFRESH_TOKEN_NCERT_SCIENCE_HI=        # one token per non-default channel (docs/PERSONAS.md)
# GEMINI_TTS_MODELS=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts,gemini-2.5-pro-preview-tts   # Hindi voice; ~10 requests/day per model on the free tier
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome
# HF_CACHE_DIR=.cache/hf
# WHISPER_DIR=.cache/whisper
# ALLOW_FALLBACK_VOICE=false      # dry runs on offline machines: use the bundled eSpeak voice if Kokoro cannot load
